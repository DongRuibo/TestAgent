# Copy this file to .env, then fill in your own values.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
AGENT_TIMEZONE=Asia/Shanghai

# Optional LazyTT Memory Service integration. The local env file is read only for
# JWT configuration; alternatively provide a short-lived MEMORY_BEARER_TOKEN.
MEMORY_ENABLED=false
MEMORY_AUTO_EXTRACT=true
# false: legacy user-message extraction; true: full-turn extraction plus 10-turn consolidation.
MEMORY_EPISODE_CONSOLIDATION_ENABLED=false
MEMORY_BASE_URL=http://127.0.0.1:8080
# MEMORY_ENV_FILE=/absolute/path/to/lazytt-memory-system/.env
# MEMORY_BEARER_TOKEN=<REDACTED>
MEMORY_TENANT_ID=demo-tenant
MEMORY_USER_ID=semantic-demo
MEMORY_PROJECT_ID=lazytt-memory-system-demo
MEMORY_TIMEOUT_SECONDS=30
MEMORY_PROJECTION_TIMEOUT_SECONDS=8
MEMORY_RECALL_POLICY=adaptive

# Optional read-only LazyTT RAG integration. Keep the short-lived JWT in an
# ignored file; never paste it into source code or browser-side configuration.
RAG_ENABLED=false
RAG_BASE_URL=http://127.0.0.1:8082
RAG_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000000
# All four distinct attachment knowledge bases are required, must not reuse the
# long-term knowledge base, and must share the same JWT Scope and embedding
# profile. Retrieval is further limited by conversation document IDs.
RAG_ATTACHMENT_PDF_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000000
RAG_ATTACHMENT_OFFICE_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000000
RAG_ATTACHMENT_IMAGE_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000000
RAG_ATTACHMENT_MEDIA_KNOWLEDGE_BASE_ID=00000000-0000-0000-0000-000000000000
RAG_BEARER_TOKEN_FILE=/absolute/path/to/dev_token_testagent.jwt
RAG_RETRIEVAL_PROFILE=hybrid-default@1
RAG_TIMEOUT_SECONDS=30
RAG_ATTACHMENT_MAX_BYTES=104857600

# Local conversation context. Relative paths are resolved from the repository root.
CONVERSATION_DB_PATH=.local/conversations.sqlite3
CONTEXT_MAX_CHARS=40000
CONTEXT_HISTORY_MAX_CHARS=16000
CONTEXT_TOOL_RESULT_MAX_CHARS=8000

# Optional LazyTT MCP integration. By default the Agent reads the ignored
# `.local/lazytt-mcp.env`; MCP tools are namespaced as mcp__lazytt__<tool>.
# MCP_ENV_FILE=.local/lazytt-mcp.env
# MCP_ENABLED=true
# MCP_SERVER_NAME=lazytt
# MCP_SERVER_URL=http://<MCP_HOST>:8080/mcp
# OIDC_TOKEN_URL=http://<MCP_HOST>:8090/realms/lazytt-mcp/protocol/openid-connect/token
# OIDC_CLIENT_ID=<YOUR_AGENT_CLIENT_ID>
# OIDC_CLIENT_SECRET=<REDACTED>
# MCP_TOOL_ALLOWLIST=area_calculate,paint_calculate,tile_calculate,flooring_calculate
# MCP_CALL_TIMEOUT_SECONDS=30

# Optional: set this for an OpenAI-compatible provider.
# OPENAI_BASE_URL=https://api.openai.com/v1

# The single-Agent runtime calls Tavily directly. Never commit a real key.
TAVILY_API_KEY=your-tavily-api-key

# Controlled report renderer dependencies used by the Agent process.
ARTIFACT_TOOL_ROOT=/absolute/path/to/@oai/artifact-tool
# ARTIFACT_TOOL_NODE=/absolute/path/to/node
# BRIEFING_FONT_PATH=/absolute/path/to/unicode-font.ttf

# Tencent Cloud Agent Sandbox (AGSX) Code Interpreter.
# Create these values in the AGSX console. Never commit a real API key.
# Copy the "E2B compatible" form shown by the AGSX console.
E2B_API_KEY=e2b_your-agsx-api-key
E2B_DOMAIN=ap-guangzhou.tencentags.com
AGSX_TEMPLATE=your-code-interpreter-tool-name

# Browser Tool name. The current POC default matches the Tool created for this project.
AGSX_BROWSER_TEMPLATE=lazyx-browser-public-poc

# Optional standalone Sandbox Gateway settings. The default Agent does not use them.
# SANDBOX_GATEWAY_URL=http://127.0.0.1:8787
# SANDBOX_GATEWAY_API_KEY=<REDACTED>
# GATEWAY_API_KEYS=<REDACTED>|demo-tenant|demo-agent
# GATEWAY_DATA_ROOT=artifacts/gateway

# Optional PPIO comparison used by the standalone Gateway and evaluation scripts.
# PPIO_API_KEY=your-ppio-api-key
# PPIO_DOMAIN=sandbox.ppio.cn
# PPIO_TEMPLATE=code-interpreter-v1
# PPIO_BROWSER_TEMPLATE=browser-chromium
# PPIO_BROWSER_CDP_PORT=9223
