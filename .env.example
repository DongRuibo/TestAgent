# Copy this file to .env, then fill in your own values.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
AGENT_TIMEZONE=Asia/Shanghai

# Optional: set this for an OpenAI-compatible provider.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Independent Rust Web Capability Service used by web_search and web_fetch.
# The Brave key belongs in web-capability/.env, not in this Agent config.
WEB_CAPABILITY_BASE_URL=http://127.0.0.1:3020

# Agent only talks to the Sandbox Gateway. Provider keys stay in the Gateway process.
SANDBOX_GATEWAY_URL=http://127.0.0.1:8787
SANDBOX_GATEWAY_API_KEY=<REDACTED>
GATEWAY_API_KEYS=<REDACTED>|demo-tenant|demo-agent

# Controlled report renderer dependencies used by the Gateway process.
ARTIFACT_TOOL_ROOT=/absolute/path/to/@oai/artifact-tool
# ARTIFACT_TOOL_NODE=/absolute/path/to/node
# BRIEFING_FONT_PATH=/absolute/path/to/unicode-font.ttf

# Tencent Cloud Agent Sandbox (AGSX) Code Interpreter.
# Create these values in the AGSX console. Never commit a real API key.
# Copy the "E2B compatible" form shown by the AGSX console.
E2B_API_KEY=e2b_your-agsx-api-key
E2B_DOMAIN=ap-guangzhou.tencentags.com
AGSX_TEMPLATE=your-code-interpreter-tool-name

# Browser Tool name. The current POC default matches the Tool created for this project.
AGSX_BROWSER_TEMPLATE=lazyx-browser-public-poc

# Optional: PPIO Agent Sandbox comparison through the official Python SDK.
# Keep this separate from the Tencent AGSX key; do not reuse it implicitly.
# PPIO_API_KEY=your-ppio-api-key
# PPIO_DOMAIN=sandbox.ppio.cn
# PPIO_TEMPLATE=code-interpreter-v1
# PPIO_BROWSER_TEMPLATE=browser-chromium
# PPIO_BROWSER_CDP_PORT=9223
