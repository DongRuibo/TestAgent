# 搜索供应商和密钥只配置在 Web Capability Service，不放进 Agent 配置。
# WEB_SEARCH_PROVIDER 兼容旧配置；新配置建议使用 PRIMARY/FALLBACK。
WEB_SEARCH_PRIMARY_PROVIDER=tavily
WEB_SEARCH_FALLBACK_PROVIDERS=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# 搜索服务策略：总预算、单次尝试、重试、内存 TTL 缓存。
WEB_SEARCH_TOTAL_TIMEOUT_MS=10000
WEB_SEARCH_ATTEMPT_TIMEOUT_MS=4000
WEB_SEARCH_MAX_ATTEMPTS=3
WEB_SEARCH_RETRY_BASE_DELAY_MS=200
WEB_SEARCH_CACHE_ENABLED=true
WEB_SEARCH_CACHE_TTL_SECONDS=600
WEB_SEARCH_CACHE_MAX_ENTRIES=1000

WEB_CAPABILITY_BIND=127.0.0.1:3020

# 仅用于把公网 DNS 映射到 198.18.0.0/15 的受管开发代理环境。
# 生产环境必须保持 false；即使开启，直接访问 198.18/15 IP 仍会被拒绝。
WEB_CAPABILITY_ALLOW_BENCHMARK_DNS_PROXY=false

# robots.txt 策略检查：默认开启；缓存最长不超过 RFC 建议的 24 小时。
WEB_FETCH_ROBOTS_ENABLED=true
WEB_FETCH_ROBOTS_CACHE_TTL_SECONDS=3600
WEB_FETCH_ROBOTS_MAX_BODY_BYTES=524288
